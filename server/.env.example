# Public origin of this server, no trailing slash.
# Webex redirects to ${PUBLIC_BASE_URL}/oauth/webex/callback
PUBLIC_BASE_URL=http://127.0.0.1:8788
PORT=8788

# From the Webex Integration at https://developer.webex.com/my-apps
# Integration, not a bot and not a personal access token.
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=

# At least 32 characters. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# SQLite file. Mount a persistent disk here in production.
DATA_PATH=./data/webex.sqlite

# Optional comma-separated OAuth redirect URIs in addition to Cursor's callbacks.
ALLOWED_REDIRECT_URIS=
